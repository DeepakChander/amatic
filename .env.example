# Amatic environment template.
#
# Copy to `.env.local` (same directory, sibling of package.json) and fill in
# the three keys. `.env.local` is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# Verify with the backend running:  curl localhost:3001/health   -> keys present
#                                   curl localhost:3001/readyz   -> keys actually work
#
# Docs: docs/01-getting-started.md

# --- Teaching brain: pick ONE ----------------------------------------------
# ollama    fully local, free, no account. Needs Docker (see below). DEFAULT.
# gemini    Google AI Studio free tier (~1,500 req/day, no card). Needs a key.
# anthropic Claude. Best quality, paid.
LLM_PROVIDER=ollama

# Only needed for LLM_PROVIDER=ollama. Started by docker-compose.ollama.yml.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TEACHING_MODEL=qwen2.5vl:3b   # vision-capable, ~3.2 GB
# OLLAMA_CHAT_MODEL=qwen2.5:3b

# --- Keys (only for the hosted providers you actually use) ------------------
# Teaching brain when LLM_PROVIDER=anthropic. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Teaching brain when LLM_PROVIDER=gemini (free tier, no card):
#   https://aistudio.google.com/apikey
# Also used for image generation. Leave blank to serve only vetted diagrams
# from amatic-app/diagram-library (fully local, no image provider at all).
GOOGLE_AI_API_KEY=
# Voice output. Not required when TTS_PROVIDER=kokoro (the default below).
ELEVENLABS_API_KEY=

# --- Optional: ports and environment ---------------------------------------
# AI_SERVER_PORT=3001
# VITE_APP_PORT=3000
# NODE_ENV=production        # suppresses error detail in API responses

# --- Optional: logging (docs/18 Phase 2.1) ---------------------------------
# LOG_LEVEL=info             # trace|debug|info|warn|error|fatal
# LOG_PRETTY=1               # human-readable logs in a terminal (dev only)

# --- Optional: teaching brain output mode (docs/18 Phase 3.2) --------------
# json  = the ADR-003 text scanner (default)
# tools = typed tool calls, validated by the API
# MASTER_OUTPUT_MODE=json

# --- Speech (docs/18 Phase 3.4, docs/08-voice-pipeline.md) ------------------
# kokoro runs Kokoro-82M locally: no key, no cost, no network.
TTS_PROVIDER=kokoro
# KOKORO_VOICE=af_heart
# KOKORO_DTYPE=q8            # q8 (~90 MB, fast) | fp32 (larger, best quality)
# TTS_CACHE_DIR=amatic-app/.cache/tts
# TTS_CACHE_MAX_MB=200

# --- Optional: images (docs/18 Phase 3.3) ----------------------------------
# DIAGRAM_LIBRARY_DIR=amatic-app/diagram-library
# Generated images per teaching turn. Default 1 — image generation is the
# dominant cost line. Raise as the vetted diagram library fills.
# VITE_MAX_IMAGES_PER_TURN=1
